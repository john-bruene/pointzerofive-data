 "claim": {
  "question": {
   "en": "Does a late train get even later?",
   "de": "Sammelt ein verspäteter Zug noch mehr Verspätung?"
  },
  "yes_text": {
   "en": "On the rest of their route, trains that are late lose significantly more time than the same trains on days they are on time.",
   "de": "Verspätete Züge verlieren auf dem Rest ihrer Fahrt signifikant mehr Zeit als dieselben Züge an Tagen, an denen sie pünktlich sind."
  },
  "no_text": {
   "ruled_out": {
    "en": "Late trains do not lose significantly more time on the rest of their route than the same trains on time. Any extra loss is at most {bound} minutes.",
    "de": "Verspätete Züge verlieren auf dem Rest ihrer Fahrt nicht signifikant mehr Zeit als dieselben Züge, wenn sie pünktlich sind. Ein zusätzlicher Verlust liegt höchstens bei {bound} Minuten."
   },
   "not_detectable": {
    "en": "Late trains do not lose significantly more time on the rest of their route than the same trains on time. A relevant extra loss is not ruled out either.",
    "de": "Verspätete Züge verlieren auf dem Rest ihrer Fahrt nicht signifikant mehr Zeit als dieselben Züge, wenn sie pünktlich sind. Ein relevanter zusätzlicher Verlust ist aber auch nicht ausgeschlossen."
   },
   "opposite": {
    "en": "Late trains lose significantly less time on the rest of their route than the same trains on time: they make some of it up.",
    "de": "Verspätete Züge verlieren auf dem Rest ihrer Fahrt signifikant weniger Zeit als dieselben Züge, wenn sie pünktlich sind: Sie holen einen Teil auf."
   }
  },
