 "claim": {
  "question": {
   "en": "Does home advantage shrink without fans?",
   "de": "Schrumpft der Heimvorteil ohne Zuschauer?"
  },
  "yes_text": {
   "en": "Without spectators, home teams lose a significant part of their advantage.",
   "de": "Ohne Zuschauer verlieren Heimteams einen signifikanten Teil ihres Vorteils."
  },
  "no_text": {
   "ruled_out": {
    "en": "Without spectators, home advantage is not significantly smaller than in full stadiums. Any reduction is at most {bound} points per match.",
    "de": "Ohne Zuschauer ist der Heimvorteil nicht signifikant kleiner als in vollen Stadien. Eine Abnahme liegt höchstens bei {bound} Punkten pro Spiel."
   },
   "not_detectable": {
    "en": "Without spectators, home advantage is not significantly smaller than in full stadiums. A relevant reduction is not ruled out either.",
    "de": "Ohne Zuschauer ist der Heimvorteil nicht signifikant kleiner als in vollen Stadien. Eine relevante Abnahme ist aber auch nicht ausgeschlossen."
   },
   "opposite": {
    "en": "Without spectators, home advantage is significantly larger than in full stadiums.",
    "de": "Ohne Zuschauer ist der Heimvorteil signifikant größer als in vollen Stadien."
   }
  },
  "unit": {
   "en": "points per match",
   "de": "Punkte pro Spiel"
  },
  "cases": {
   "en": "{n} matches without spectators, 2020–2022",
   "de": "{n} Spiele ohne Zuschauer, 2020–2022"
  },
  "direction": "positive",
  "smallest_relevant_effect": 0.1,
  "dispute": [
   {
    "side": "yes",
    "text": {
     "en": "Yes, found McCarrick and colleagues (2021) in 4,844 matches from 15 European leagues: without crowds, home teams scored fewer goals and took fewer points.",
     "de": "Ja, fanden McCarrick und Kollegen (2021) in 4.844 Spielen aus 15 europäischen Ligen: Ohne Publikum schossen Heimteams weniger Tore und holten weniger Punkte."
    },
    "source": "McCarrick, Bilalic, Neave & Wolfson 2021, Psychology of Sport and Exercise 56: 102013, doi:10.1016/j.psychsport.2021.102013"
   },
   {
    "side": "no",
    "text": {
     "en": "No, found Schank, Voigt and Orthey (2024) for the Bundesliga: in 2020/21, a season almost entirely without fans, home advantage was about as large as in 2018/19.",
     "de": "Nein, fanden Schank, Voigt und Orthey (2024) für die Bundesliga: In der Saison 2020/21, fast komplett ohne Fans, war der Heimvorteil etwa so groß wie 2018/19."
    },
    "source": "Schank, Voigt & Orthey 2024, arXiv:2411.12509 (preprint)"
   }
  ]
 },
